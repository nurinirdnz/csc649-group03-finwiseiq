# FinWiseIQ environment variables - TEMPLATE ONLY
#
# 1. Copy this file to .env   (PowerShell: Copy-Item .env.example .env)
# 2. Replace the placeholder below with your own OpenAI API key.
# 3. NEVER commit .env. It is listed in .gitignore.
#
# These values are read only by the backend (src/). They must never be
# passed to the Gradio interface, printed, logged or shown to users.

# Your personal OpenAI API key (create one at https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI API model ID used for answer generation.
# "gpt-6-luna" was checked on the official model list
# (https://developers.openai.com/api/docs/models) on 12 November 2026.
# Re-check that page before submission; model IDs can be deprecated.
OPENAI_MODEL=gpt-6-luna
